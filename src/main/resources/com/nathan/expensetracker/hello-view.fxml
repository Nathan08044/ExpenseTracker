<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nathan.expensetracker.TrackerController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" alignment="TOP_LEFT" text="Expense Tracker">
      <font>
         <Font size="28.0" />
      </font>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding></Label>
   <HBox spacing="30.0">
      <children>
         <Label fx:id="incomeLabel" text="Income: $0.00 " />
         <Label fx:id="expenseLabel" text="Expense: $0.00" />
         <Label fx:id="balanceLabel" text="Balance: $0.00" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
      <children>
         <TextField fx:id="titleField" prefWidth="200.0" promptText="Title" />
         <TextField fx:id="amountField" prefWidth="120.0" promptText="Amount" />
         <TextField fx:id="categoryField" prefWidth="150.0" promptText="Category" />
      </children>
   </HBox>
   <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
      <children>
         <ComboBox fx:id="typeComboBox" prefWidth="150.0" promptText="Type" />
         <DatePicker fx:id="datePicker" promptText="Date" />
         <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddTransaction" text="Add transaction" />
         <Button mnemonicParsing="false" onAction="#handleDeleteTransaction" text="Delete selected" />
      </children>
   </HBox>
   <TableView fx:id="transactionTable" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
      <columns>
         <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />
         <TableColumn fx:id="amountColumn" prefWidth="75.0" text="Amount" />
         <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
         <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
         <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Type" />
      </columns>
   </TableView>
</VBox>
