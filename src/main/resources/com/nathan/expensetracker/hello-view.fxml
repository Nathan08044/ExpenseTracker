<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" style="-fx-background-color: #F4F6FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nathan.expensetracker.TrackerController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
      
          <Label fx:id="welcomeText" alignment="TOP_LEFT" text="Expense Tracker">
            <font>
               <Font name="Avenir Black Oblique" size="38.0" />
            </font>
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
         </Label>
         <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
         <ComboBox fx:id="monthCombobox" prefWidth="150.0" />
      </children>
   </HBox>
   <Label text="A clearer view of your everyday spending" textFill="#667085">
      <font>
         <Font name="Avenir Black" size="13.0" />
      </font></Label>
   <HBox spacing="16.0" VBox.vgrow="NEVER">
      <children>
         <VBox prefWidth="240.0" style="-fx-background-color: #EAF7F0; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="16.0">
                  <children>
                     <Label alignment="CENTER" maxHeight="48.0" maxWidth="48.0" minHeight="48.0" minWidth="48.0" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: #D5F2E8; -fx-background-radius: 24;" text="↗" textFill="#087a5c">
                        <font>
                           <Font size="28.0" />
                        </font>
                     </Label>
                     <VBox alignment="CENTER_LEFT" prefWidth="100.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-background-color: #EAF7F0; -fx-background-radius: 12;" text="Total income" />
                           <Label fx:id="incomeLabel" text="\$0.00 " textFill="#087a5c">
                              <font>
                                 <Font size="28.0" />
                              </font>
                           </Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>
            </children>
            <padding>
               <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
         </VBox>
         <VBox prefWidth="240.0" style="-fx-background-color: #FCECEF; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="16.0">
                  <children>
                     <Label alignment="CENTER" maxHeight="48.0" maxWidth="48.0" minHeight="48.0" minWidth="48.0" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: #FADCE4; -fx-background-radius: 24;" text="↓" textFill="#c8103d">
                        <font>
                           <Font size="28.0" />
                        </font>
                     </Label>
                     <VBox alignment="CENTER_LEFT" prefWidth="100.0" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-background-color: #FCECEF; -fx-background-radius: 12;" text="Total expenses" />
                           <Label fx:id="expenseLabel" text="\$0.00" textFill="#c8103d">
                              <font>
                                 <Font size="28.0" />
                              </font>
                           </Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>
            </children>
            <padding>
               <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
         </VBox>
         <VBox prefWidth="240.0" style="-fx-background-color: #EAF2FF; -fx-background-radius: 12;" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT" prefWidth="200.0" spacing="16.0">
                  <children>
                     <Label alignment="CENTER" lineSpacing="16.0" maxHeight="48.0" maxWidth="48.0" minHeight="48.0" minWidth="48.0" prefHeight="48.0" prefWidth="48.0" style="-fx-background-color: #DCE8FF; -fx-background-radius: 24;" text="\$" textOverrun="CLIP">
                        <font>
                           <Font name="Arial Black" size="28.0" />
                        </font>
                        <textFill>
                           <LinearGradient endX="1.0" endY="1.0">
                              <stops>
                                 <Stop>
                                    <color>
                                       <Color />
                                    </color>
                                 </Stop>
                                 <Stop offset="1.0">
                                    <color>
                                       <Color red="0.16078431904315948" green="0.2705882489681244" blue="0.7803921699523926" />
                                    </color>
                                 </Stop>
                              </stops>
                           </LinearGradient>
                        </textFill>
                     </Label>
                     <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                        <children>
                           <Label style="-fx-background-color: #EAF2FF; -fx-background-radius: 12;" text="Current balance" />
                           <Label fx:id="balanceLabel" text="\$0.00" textFill="#2945c7">
                              <font>
                                 <Font size="28.0" />
                              </font>
                           </Label>
                        </children>
                     </VBox>
                  </children>
               </HBox>
            </children>
            <padding>
               <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
         </VBox>
      </children>
   </HBox>
   <LineChart fx:id="spendingChart" legendSide="RIGHT" legendVisible="true" prefHeight="180.0" styleClass="spending-chart" stylesheets="@transactions.css" title="Income and Spending - Last 6 months" VBox.vgrow="NEVER">
     <xAxis>
       <CategoryAxis side="BOTTOM" />
     </xAxis>
     <yAxis>
       <NumberAxis label="Amount (USD)" lowerBound="-1000.0" side="LEFT" tickUnit="500.0" upperBound="16000.0" />
     </yAxis>
   </LineChart>
   <VBox prefWidth="100.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;" VBox.vgrow="NEVER">
      <children>
         <Label text="Add transaction">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
         <HBox alignment="BOTTOM_LEFT" fillHeight="false" spacing="10.0">
            <children>
               <VBox alignment="BOTTOM_LEFT" prefWidth="150.0">
                  <children>
                     <Label text="Title" />
                     <TextField fx:id="titleField" promptText="Title" />
                  </children>
               </VBox>
               <VBox alignment="BOTTOM_LEFT" prefWidth="100.0">
                  <children>
                     <Label text="Amount" />
                     <TextField fx:id="amountField" prefWidth="120.0" promptText="Amount" />
                  </children>
               </VBox>
               <VBox alignment="BOTTOM_LEFT" prefWidth="130.0">
                  <children>
                     <Label text="Category" />
                     <TextField fx:id="categoryField" prefWidth="150.0" promptText="Category" />
                  </children>
               </VBox>
               <VBox alignment="BOTTOM_LEFT" prefWidth="100.0">
                  <children>
                     <Label text="Type" />
                     <ComboBox fx:id="typeComboBox" prefWidth="150.0" promptText="Type" />
                  </children>
               </VBox>
               <VBox alignment="BOTTOM_LEFT" prefWidth="145.0">
                  <children>
                     <Label text="Date" />
                     <DatePicker fx:id="datePicker" promptText="Date" />
                  </children>
               </VBox>
               <Button mnemonicParsing="false" onAction="#handleScanReceipt" text="Scan receipt" />
               <Button fx:id="addButton" alignment="TOP_LEFT" contentDisplay="TOP" mnemonicParsing="false" onAction="#handleAddTransaction" style="-fx-background-color: #4355D4; -fx-text-fill: white; -fx-background-radius: 8;" text="Add transaction" />
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
      </padding>
   </VBox>
   <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
      <children>
         <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
            <children>
               <Label text="Transactions">
                  <font>
                     <Font name="System Bold" size="18.0" />
                  </font>
               </Label>
               <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#handleDeleteTransaction" text="Delete selected" />
            </children>
         </HBox>
         <TableView fx:id="transactionTable" prefHeight="300.0" prefWidth="200.0" stylesheets="@transactions.css" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />
               <TableColumn fx:id="amountColumn" prefWidth="75.0" text="Amount" />
               <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
               <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
               <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Type" />
            </columns>
         </TableView>
         <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
               <Label fx:id="transactionCountLabel" text="0 Transaction" textFill="#667085" />
               <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
               <Label text="Store locally on your device" textFill="#667085" />
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
      </padding>
   </VBox>
</VBox>
