<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="15.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nathan.expensetracker.TrackerController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" alignment="TOP_LEFT" text="Expense Tracker">
      <font>
         <Font name="System Bold" size="36.0" />
      </font>
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding></Label>
   <Label text="A clearer view of your everyday spending" textFill="#667085" />
   <HBox spacing="16.0">
      <children>
         <VBox prefHeight="200.0" prefWidth="240.0" style="-fx-background-color: #EAF7F0; -fx-background-radius: 12;">
            <children>
               <Label style="-fx-background-color: #EAF7F0; -fx-background-radius: 12;" text="Total income">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
               </Label>
               <Label fx:id="incomeLabel" text="\$0.00 " textFill="#087a5c">
                  <font>
                     <Font size="28.0" />
                  </font>
               </Label>
            </children>
         </VBox>
         <VBox prefHeight="200.0" prefWidth="240.0" style="-fx-background-color: #FCECEF; -fx-background-radius: 12;">
            <children>
               <Label style="-fx-background-color: #FCECEF; -fx-background-radius: 12;" text="Total expenses">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
               </Label>
               <Label fx:id="expenseLabel" text="\$0.00" textFill="#c8103d">
                  <font>
                     <Font size="28.0" />
                  </font>
               </Label>
            </children>
         </VBox>
         <VBox prefHeight="200.0" prefWidth="240.0" style="-fx-background-color: #EAF2FF; -fx-background-radius: 12;">
            <children>
               <Label style="-fx-background-color: #EAF2FF; -fx-background-radius: 12;" text="Current balance">
                  <padding>
                     <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                  </padding>
               </Label>
               <Label fx:id="balanceLabel" text="\$0.00" textFill="#2945c7">
                  <font>
                     <Font size="28.0" />
                  </font>
               </Label>
            </children>
         </VBox>
      </children>
   </HBox>
   <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;">
      <children>
         <Label text="Add transaction">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
         <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
               <TextField fx:id="titleField" prefWidth="200.0" promptText="Title" />
               <TextField fx:id="amountField" prefWidth="120.0" promptText="Amount" />
               <TextField fx:id="categoryField" prefWidth="150.0" promptText="Category" />
            </children>
         </HBox>
         <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
               <ComboBox fx:id="typeComboBox" prefWidth="150.0" promptText="Type" />
               <DatePicker fx:id="datePicker" promptText="Date" />
               <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddTransaction" style="-fx-background-color: #4355D4; -fx-text-fill: white; -fx-background-radius: 8;" text="Add transaction" />
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
      </padding>
   </VBox>
   <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;" VBox.vgrow="ALWAYS">
      <children>
         <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
            <children>
               <Label text="Transactions">
                  <font>
                     <Font name="System Bold" size="18.0" />
                  </font>
               </Label>
               <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
               <Button mnemonicParsing="false" onAction="#handleDeleteTransaction" text="Delete selected" />
            </children>
         </HBox>
         <TableView fx:id="transactionTable" prefHeight="300.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />
               <TableColumn fx:id="amountColumn" prefWidth="75.0" text="Amount" />
               <TableColumn fx:id="dateColumn" prefWidth="75.0" text="Date" />
               <TableColumn fx:id="categoryColumn" prefWidth="75.0" text="Category" />
               <TableColumn fx:id="typeColumn" prefWidth="75.0" text="Type" />
            </columns>
         </TableView>
      </children>
      <padding>
         <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
      </padding>
   </VBox>
</VBox>
